{
  "expo": {
    "name": "Ginásio KO",
    "slug": "ko-gym-mobile",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "site.ginasioko.app",
      "infoPlist": {
        "NFCReaderUsageDescription": "Usamos o NFC para fazeres check-in ao encostar o telemóvel ao autocolante à entrada do ginásio."
      }
    },
    "android": {
      "package": "site.ginasioko.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A1A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "react-native-nfc-manager",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos das tuas fotografias para poderes escolher a tua foto de atleta."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0f8d3251-81fb-48cf-8b8e-8b33f8f92500"
      }
    },
    "owner": "ginasio-ko"
  }
}
